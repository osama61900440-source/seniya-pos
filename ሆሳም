    if (s && s.trim()) return s.trim();
    s = localStorage.getItem("current_store_id") || localStorage.getItem("store_id");
    if (s && s.trim()) return s.trim();
    var sCur = sessionStorage.getItem("currentUser") || sessionStorage.getItem("authUser");
    if (sCur) {
