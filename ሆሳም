export function loadPrefs() {
  try {
    var v = localStorage.getItem(PREFS_KEY);
    var p = null;
    if (v) {
      p = JSON.parse(v);
    }
    var fp = freshPrefs();
    if (!p || typeof p !== "object") {
      p = fp;
    } else {
      for (var k in fp) if (!(k in p)) p[k] = fp[k];
    }
    // Check explicit theme preference in localStorage ('light' or 'dark')
    var savedTheme = localStorage.getItem("theme");
    if (savedTheme === "dark") {
      p.darkMode = true;
    } else if (savedTheme === "light") {
      p.darkMode = false;
    }
    return p;
  } catch (e) {}
  return freshPrefs();
}

export function savePrefs(p) {
  try {
    localStorage.setItem(PREFS_KEY, JSON.stringify(p));
    if (p && typeof p.darkMode === "boolean") {
      localStorage.setItem("theme", p.darkMode ? "dark" : "light");
    }
  } catch (e) {}
}

export function applyPrefs(p) {
  var isDark = !!(p && p.darkMode);
  if (typeof document !== "undefined") {
    if (document.body) {
      document.body.classList.toggle("dark", isDark);
      document.body.classList.toggle("light-theme", !isDark);
      document.body.setAttribute("data-theme", isDark ? "dark" : "light");
    }
    if (document.documentElement) {
      document.documentElement.classList.toggle("dark", isDark);
      document.documentElement.classList.toggle("light-theme", !isDark);
      document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
      document.documentElement.style.setProperty("--accent", (p && p.accent) || ACCENT_PRESETS[0]);
    }
