    type: "button"
  }, "አረጋግጥ እና ግባ");

  verifySubmitBtn.addEventListener("click", function () {
    var code = (codeInput.value || "").trim().replace(/\D/g, "");
    if (!code || code.length !== 6) {
      codeInput.classList.add("is-invalid");
