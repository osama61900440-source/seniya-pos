      el("div", {
        style: {
          fontSize: "13px",
          fontWeight: "700",
          lineHeight: "1.5",
          color: isWarning ? "#92400e" : "#0f172a"
        }
      }, message),
      el("div", {
        style: {
          display: "flex",
          justifyContent: "flex-end",
          marginTop: "8px"
        }
      }, [
        el("button", {
          type: "button",
          style: {
            background: isWarning ? "#d97706" : "#0284c7",
            color: "#ffffff",
            border: "none",
            borderRadius: "8px",
            padding: "5px 14px",
            fontSize: "12px",
            fontWeight: "800",
            cursor: "pointer"
          },
          onclick: clearInAppAlert
        }, "እሺ")
      ])
    ]);
